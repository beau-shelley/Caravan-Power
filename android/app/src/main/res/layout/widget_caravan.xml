<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (4 x 2). Filled in by CaravanWidget.kt; the text here is the "not live" look. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CARAVAN" android:textColor="#FF9BE03A" android:textSize="12sp" android:textStyle="bold"
            android:letterSpacing="0.12" android:maxLines="1" />
        <TextView android:id="@+id/w_status"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:gravity="end"
            android:text="Open the app to connect" android:textColor="#FFFFB020" android:textSize="11sp"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- Battery ring (a bitmap drawn by WidgetRing): outer arc = charge %, inner arc = the minute's
             net current (green charging, red discharging). The % and the net figure sit in the middle. -->
        <FrameLayout android:layout_width="84dp" android:layout_height="match_parent">
            <ImageView android:id="@+id/w_ring"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/w_soc"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textColor="#FF9A9FA5" android:textSize="18sp" android:textStyle="bold"
                    android:includeFontPadding="false" android:maxLines="1" />
                <TextView android:id="@+id/w_net"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--" android:textColor="#FF9A9FA5" android:textSize="10sp" android:textStyle="bold"
                    android:includeFontPadding="false" android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Net, 1 min average" android:textColor="#FF9A9FA5" android:textSize="11sp"
                android:maxLines="1" />
            <TextView android:id="@+id/w_flow"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="--" android:textColor="#FF9A9FA5" android:textSize="16sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_time"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFD3D6D9" android:textSize="12sp" android:visibility="gone"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <TextView android:id="@+id/w_water_l"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Water" android:textColor="#FF5CCBFF" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_water_v"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="--" android:textColor="#FF9A9FA5" android:textSize="16sp" android:textStyle="bold"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <TextView android:id="@+id/w_gas_l"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Gas" android:textColor="#FFFFA35C" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_gas_v"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="--" android:textColor="#FF9A9FA5" android:textSize="16sp" android:textStyle="bold"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <TextView android:id="@+id/w_in_l"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Inside" android:textColor="#FFFFFFFF" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_in_v"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="--" android:textColor="#FF9A9FA5" android:textSize="16sp" android:textStyle="bold"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">
            <TextView android:id="@+id/w_fr_l"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Fridge" android:textColor="#FFFFFFFF" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_fr_v"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="--" android:textColor="#FF9A9FA5" android:textSize="16sp" android:textStyle="bold"
                android:includeFontPadding="false" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
