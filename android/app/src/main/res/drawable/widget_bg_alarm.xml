<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background while an alarm (or critical alert) is unacknowledged: red wash and outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="300" android:startColor="#F5461E28" android:endColor="#F8121014" />
    <stroke android:width="1.5dp" android:color="#B3FF6B6B" />
    <corners android:radius="24dp" />
</shape>
